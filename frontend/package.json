{
  "name": "yuzhua-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "愈爪|宠物医院预约与在线问诊平台前端（用户端 + 管理后台，单工程双入口）",
  "scripts": {
    "dev": "node -r ./esbuild-tmp-shim.cjs node_modules/vite/bin/vite.js",
    "build": "node -r ./esbuild-tmp-shim.cjs node_modules/vite/bin/vite.js build",
    "preview": "vite preview --port 4173",
    "lint": "eslint src tests tools eslint.config.js",
    "style-guard": "node tools/style-guard/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run style-guard && npm run test:coverage && npm run build",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 \"--test-coverage-include=tools/style-guard/index.mjs\" \"--test-coverage-include=src/utils/tableDensity.js\" \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "axios": "^1.7.7",
    "echarts": "^5.5.1",
    "element-plus": "^2.8.4",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^15.15.0",
    "vite": "^5.4.9",
    "vue-eslint-parser": "^10.4.2"
  }
}
